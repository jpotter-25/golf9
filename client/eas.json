{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "playtest"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "playtest",
        "EXPO_PUBLIC_STAGING_SERVER_URL": "https://ninebelow.potterwell.com"
      },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "playtest": {
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "playtest",
        "EXPO_PUBLIC_STAGING_SERVER_URL": "https://ninebelow.potterwell.com"
      },
      "ios": { "simulator": false },
      "android": { "buildType": "app-bundle" }
    },
    "testflight": {
      "extends": "playtest",
      "distribution": "store",
      "env": { "EXPO_PUBLIC_APP_TARGET": "ios" },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "ios-simulator": {
      "extends": "testflight",
      "ios": { "simulator": true }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "production",
        "EXPO_PUBLIC_PROD_SERVER_URL": "https://ninebelow.potterwell.com"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6814632886",
        "appleTeamId": "63FQJRQ66P"
      }
    },
    "production": {}
  }
}
