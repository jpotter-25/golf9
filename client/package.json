  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "verify-deps": "expo install --check",
    "eas-build-post-install": "npm run verify-deps && npm run test:native-codegen && npm run test:social-auth && npm run test:header && npm run test:ranked && npm run test:table",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:browser": "node --test test/browserAlert.test.cjs",
    "test:native-codegen": "node --test test/nativeCodegen.test.cjs",
    "test:social-auth": "node --test test/socialAuth.test.cjs",
    "test:header": "node --test test/coinBalance.test.cjs",
    "test:ranked": "node --test test/rankedLayout.test.cjs",
    "test:table": "node --test test/tableVisibility.test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.0.14",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-in-app-updates": "^0.12.0",
    "expo-linear-gradient": "~15.0.8",
    "expo-navigation-bar": "~5.0.9",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.20.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.9.0",
    "eslint-config-universe": "^15.0.3",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-in-app-updates"
        ]
      }
    }
  },
  "engines": {
    "node": ">=18"
  }
}
