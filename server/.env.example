NODE_ENV=development
APP_ENV=development
PORT=3001
CLIENT_ORIGINS=*
DATA_DIR=./data

# Development uses JSON persistence unless DATABASE_URL is set. Production
# requires TLS. Prefer a trusted CA; Railway private Postgres currently uses a
# self-signed certificate, so its private-network exception is explicitly set
# with DATABASE_SSL_REJECT_UNAUTHORIZED=0 in the hosting runbook.
DATABASE_URL=
DATABASE_SSL=0
DATABASE_SSL_REJECT_UNAUTHORIZED=1
DATABASE_SSL_CA=
TRUST_PROXY_HOPS=1

# HMAC key for persisted session, invite, and support-link verifiers. Use a
# stable independent random value of at least 32 characters in production.
SERVER_TOKEN_SECRET=

# Public URLs shown to clients/admin tools.
PUBLIC_API_URL=http://localhost:3001
ADMIN_PUBLIC_URL=http://localhost:3001/admin

# Pre-alpha / staging invite gate.
REQUIRE_INVITE_CODE=0

# Local-only bootstrap helpers. Keep disabled in staging/production.
SEED_ADMIN_ACCOUNT=1
SEED_TEST_ACCOUNTS=1
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me
ADMIN_BOOTSTRAP_MFA_CODE=000000

# Transactional email for admin recovery, early access, and public support tickets.
# Outgoing mail uses the unmonitored no-reply mailbox; support submissions still
# route to the separately monitored support inbox.
# Use secure port 465 with ADMIN_SMTP_SECURE=1, or required STARTTLS on port
# 587 with 0. The server refuses to downgrade a port-587 delivery to plaintext.
ADMIN_EMAIL_TEST_MODE=1
ADMIN_SMTP_HOST=
ADMIN_SMTP_PORT=587
ADMIN_SMTP_SECURE=0
ADMIN_SMTP_USER=donotreply@potterwell.com
ADMIN_SMTP_PASS=
ADMIN_SMTP_FROM=donotreply@potterwell.com
ADMIN_SMTP_CONNECTION_TIMEOUT_MS=10000
ADMIN_SMTP_GREETING_TIMEOUT_MS=10000
ADMIN_SMTP_SOCKET_TIMEOUT_MS=20000
SUPPORT_INBOX_EMAIL=app-developer@potterwell.com

# Early-access signups are paused by default and opened from the admin console.
# Use independent random values of at least 32 characters for both secrets.
EARLY_ACCESS_PII_KEY=
EARLY_ACCESS_TOKEN_SECRET=
EARLY_ACCESS_CAMPAIGN_EMAIL_ENABLED=0
EARLY_ACCESS_POSTAL_ADDRESS=
EARLY_ACCESS_REPLY_TO=donotreply@potterwell.com
EARLY_ACCESS_EMAILS_PER_MINUTE=60
