NODE_ENV=development
APP_ENV=development
PORT=3001
CLIENT_ORIGINS=*
DATA_DIR=./data

# Development uses JSON persistence unless DATABASE_URL is set.
DATABASE_URL=
DATABASE_SSL=0

# Public URLs shown to clients/admin tools.
PUBLIC_API_URL=http://localhost:3001
ADMIN_PUBLIC_URL=http://localhost:3001/admin

# Pre-alpha / staging invite gate.
REQUIRE_INVITE_CODE=0

# Local-only bootstrap helpers. Keep disabled in staging/production.
SEED_ADMIN_ACCOUNT=1
SEED_TEST_ACCOUNTS=1
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me
ADMIN_BOOTSTRAP_MFA_CODE=000000

# Transactional email for admin recovery and public support tickets.
# Use secure port 465 with ADMIN_SMTP_SECURE=1, or STARTTLS port 587 with 0.
ADMIN_EMAIL_TEST_MODE=1
ADMIN_SMTP_HOST=
ADMIN_SMTP_PORT=587
ADMIN_SMTP_SECURE=0
ADMIN_SMTP_USER=
ADMIN_SMTP_PASS=
ADMIN_SMTP_FROM=
ADMIN_SMTP_CONNECTION_TIMEOUT_MS=10000
ADMIN_SMTP_GREETING_TIMEOUT_MS=10000
ADMIN_SMTP_SOCKET_TIMEOUT_MS=20000
SUPPORT_INBOX_EMAIL=app-developer@potterwell.com
